# The model that reads the engineer's sentence. Optional: without a key the
# pipeline lays the screen out from the tag names alone and says so in the
# build timeline. Gemini is checked first, then Claude.

# Google AI Studio - the free tier. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Anthropic. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Where scripts/extract-skeleton.mjs and scripts/index-graphics.mjs read from.
# Point this at your own EcoStruxure Operator Terminal Expert 4.4 installation.
OTE_INSTALL_DIR=C:\Program Files\Schneider Electric\EcoStruxure Operator Terminal Expert 4.4
