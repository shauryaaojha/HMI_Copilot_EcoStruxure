# The model that reads the engineer's sentence. Optional: without a provider
# the pipeline lays the screen out from the tag names alone and says so in the
# build timeline; the conversation says it cannot read a request in words.
#
# The provider is chosen here, never by which key happens to be set:
#   AI_PROVIDER=claude   the default when ANTHROPIC_API_KEY is set
#   AI_PROVIDER=gemini   opt in; a Gemini key alone selects nothing
#   AI_PROVIDER=none     run fully offline
# AI_MODEL overrides the model id (claude-opus-5 / GEMINI_MODEL by default).
AI_PROVIDER=
AI_MODEL=

# Google AI Studio - the free tier. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Anthropic. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Where scripts/extract-skeleton.mjs and scripts/index-graphics.mjs read from.
# Point this at your own EcoStruxure Operator Terminal Expert 4.4 installation.
OTE_INSTALL_DIR=C:\Program Files\Schneider Electric\EcoStruxure Operator Terminal Expert 4.4

# Existing MongoDB connection; required for durable storage on Vercel.
MONGODB_URI=
# Optional database name; defaults to hmi_copilot.
MONGODB_DB=
# Auth.js encryption/signing secret, and the switch that turns accounts on:
# set it and this installation holds email-and-password accounts of its own;
# leave it empty and a laptop is one local engineer while a deployment is
# anonymous. Generate one with `openssl rand -base64 32` and keep it out of
# the repository.
AUTH_SECRET=
# Optional canonical Auth.js URL for custom reverse-proxy deployments.
AUTH_URL=
# Set true only behind a trusted reverse proxy; Vercel is inferred by Auth.js.
AUTH_TRUST_HOST=
# VERCEL is set by the host; never set it for implicit-user local development.

# Supabase, for live sync and nothing else. All four together or none: with
# only the public pair set, browsers try Realtime while the server can neither
# mint a token nor broadcast, and every session falls back to the event
# stream. docs/REALTIME_SETUP.md says where each one is in the dashboard, and
# what to do if the project has JWT signing keys and no legacy JWT secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; signs the short-lived token naming one project's channel.
SUPABASE_JWT_SECRET=
# Server-only; publishes the revision notice after a write.
SUPABASE_SERVICE_ROLE_KEY=
# 16+ random characters, sent by Vercel Cron as `Authorization: Bearer <value>`.
# /api/realtime/keepalive refuses every request without it, the cron's
# included, so leaving this unset turns the keep-alive off rather than open.
CRON_SECRET=
